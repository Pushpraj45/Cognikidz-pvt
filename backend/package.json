{
  "name": "cognikidz-api",
  "version": "1.0.0",
  "description": "CogniKidz API - MongoDB, Express, Node.js backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required for Node.js'",
    "vercel-build": "npm install && echo 'Dependencies installed for Vercel deployment'",
    "postinstall": "echo 'Post-install hook completed'",
    "safe-start": "node scripts/safe-start.js",
    "monitor": "node scripts/monitor-server.js",
    "stop": "pkill -f 'node server.js' || echo 'No server process found'",
    "restart": "npm run stop && npm run start",
    "test": "jest",
    "test:pipeline": "cd pipeline/core && npm run test:simple",
    "test:pipeline-unit": "cd pipeline/core && jest tests/unit/scoring/risk-calculator.simple.test.js --config jest.config.js",
    "test:pipeline-integration": "cd pipeline/core && jest tests/integration/pipeline-workflow.test.js --config jest.config.js",
    "test:pipeline-coverage": "cd pipeline/core && jest --config jest.config.js --coverage --collectCoverageFrom='**/*.js' --coveragePathIgnorePatterns='node_modules,tests'",
    "test:pipeline-watch": "cd pipeline/core && jest --config jest.config.js --watch",
    "test-progress": "node test-progress-api.js",
    "test-integration": "node test-progress-integration.js",
    "test-s3": "node scripts/test-aws-s3.js",
    "test-image-assessment": "node scripts/test-image-assessment-flow.js",
    "test-pdf-service": "node scripts/test-pdf-service.js",
    "validate-vercel": "node scripts/validate-vercel-deployment.js",
    "upload-assessment-images": "node scripts/upload-assessment-images.js",
    "seed:articles": "node scripts/seed-articles.js",
    "security-audit": "npm audit",
    "security-check": "npm audit --audit-level moderate",
    "lint": "node -c server.js && node -c api/index.js",
    "lint:full": "node scripts/syntax-check.js",
    "format:check": "echo JavaScript formatting check - manual review required",
    "quality:check": "npm run lint && npm run format:check",
    "grant-test-access": "node grant-test-access.js",
    "add-test-user": "node scripts/add-test-user.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.823.0",
    "@azure/openai": "^2.0.0",
    "@google-cloud/translate": "^9.1.0",
    "@langchain/openai": "^0.5.10",
    "@sparticuz/chromium": "^137.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^6.0.1",
    "joi": "^17.7.0",
    "jsonwebtoken": "^9.0.0",
    "langchain": "^0.3.24",
    "mongoose": "^7.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^4.2.0",
    "nodemailer": "^6.8.0",
    "openai": "^4.98.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "puppeteer": "^23.9.0",
    "puppeteer-core": "^24.11.0",
    "razorpay": "^2.9.6",
    "uuid": "^9.0.1",
    "winston": "^3.8.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "chai": "^5.2.0",
    "jest": "^29.3.1",
    "jest-summary-reporter": "^0.0.2",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "CogniKidz Team",
  "license": "MIT"
}
